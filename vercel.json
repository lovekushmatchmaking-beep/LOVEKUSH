{
  "rewrites": [
    {
      "source": "/share/m/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|TelegramBot|Twitterbot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterest|Googlebot|bingbot|Applebot|Snapchat|Viber|redditbot|Embedly).*"
        }
      ],
      "destination": "/api/share-preview?bundle=:token"
    },
    {
      "source": "/share/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|TelegramBot|Twitterbot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterest|Googlebot|bingbot|Applebot|Snapchat|Viber|redditbot|Embedly).*"
        }
      ],
      "destination": "/api/share-preview?token=:token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
